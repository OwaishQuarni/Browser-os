#!/usr/bin/env python3
"""Browser OS start page + Wi-Fi setup. Listens on localhost only."""
import json, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8080
HOSTS = {f"localhost:{PORT}", f"127.0.0.1:{PORT}"}
ORIGINS = {f"http://{h}" for h in HOSTS}

PAGE = r"""<!doctype html><html lang="en"><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Browser OS</title>
<style>
:root{color-scheme:dark}
body{margin:0;font:16px system-ui,sans-serif;background:#0d1b24;color:#e6f1f5;display:grid;place-items:center;min-height:100vh}
main{width:min(560px,92vw)}h1{font-weight:600}
form.s{display:flex;gap:8px}
input,button{font:inherit;padding:12px 14px;border-radius:10px;border:1px solid #2b4352;background:#13262f;color:inherit}
form.s input{flex:1}
button{cursor:pointer;background:#1f8f7e;border:0;color:#04201b;font-weight:600}
.links{display:flex;gap:16px;margin:18px 0;flex-wrap:wrap}.links a{color:#9fe8da}
section{background:#13262f;border-radius:14px;padding:16px;margin-top:20px}
li{list-style:none;padding:9px 0;display:flex;justify-content:space-between;cursor:pointer;border-top:1px solid #20384a}
ul{padding:0;margin:12px 0 0}
</style>
<main><h1>Browser OS</h1>
<form class="s" action="https://www.google.com/search"><input name="q" placeholder="Search the web" autofocus><button>Search</button></form>
<div class="links"><a href="https://www.youtube.com">YouTube</a><a href="https://www.wikipedia.org">Wikipedia</a><a href="https://docs.google.com">Google Docs</a><a href="https://mail.google.com">Gmail</a></div>
<section><div style="display:flex;justify-content:space-between;align-items:center"><b id="st">Checking connection…</b><button id="sc">Wi-Fi networks</button></div>
<ul id="ls"></ul>
<form id="pf" hidden style="margin-top:12px"><div id="pn" style="margin-bottom:8px"></div>
<input id="pw" type="password" placeholder="Wi-Fi password"> <button>Connect</button></form>
<div id="msg" style="margin-top:8px"></div></section></main>
<script>
const $=i=>document.getElementById(i);let cur=null;
async function status(){try{const s=await(await fetch('/api/status')).json();$('st').textContent=s.online?'Online ('+s.name+')':'Not connected'}catch(e){$('st').textContent='Not connected'}}
async function scan(){$('ls').textContent='Scanning…';const n=await(await fetch('/api/scan')).json();$('ls').textContent='';
 n.forEach(w=>{const li=document.createElement('li');li.textContent=w.ssid+(w.secure?'  (secured)':'')+'  '+w.signal+'%';li.onclick=()=>pick(w);$('ls').append(li)});
 if(!n.length)$('ls').textContent='No networks found.'}
function pick(w){cur=w;$('pf').hidden=false;$('pn').textContent=w.ssid;$('pw').hidden=!w.secure;$('pw').value='';$('pw').focus()}
$('sc').onclick=scan;
$('pf').onsubmit=async e=>{e.preventDefault();$('msg').textContent='Connecting…';
 const r=await fetch('/api/connect',{method:'POST',headers:{'Content-Type':'application/json','X-BrowserOS':'1'},body:JSON.stringify({ssid:cur.ssid,password:$('pw').value})});
 const j=await r.json();$('msg').textContent=j.ok?'Connected.':'Could not connect. '+j.message;status()};
status();
</script></html>"""


def nmcli(*args):
    try:
        return subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=45)
    except Exception as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def split_terse(line):
    return [p.replace("\0", ":") for p in line.replace("\\:", "\0").split(":")]


def scan():
    r = nmcli("-t", "-f", "SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes")
    best = {}
    for line in r.stdout.splitlines():
        p = split_terse(line)
        if len(p) < 3 or not p[0]:
            continue
        sig = int(p[1] or 0)
        if p[0] not in best or sig > best[p[0]]["signal"]:
            best[p[0]] = {"ssid": p[0], "signal": sig, "secure": p[2] not in ("", "--")}
    return sorted(best.values(), key=lambda n: -n["signal"])


def status():
    r = nmcli("-t", "-f", "TYPE,STATE,CONNECTION", "dev")
    for line in r.stdout.splitlines():
        t, s, c = (split_terse(line) + ["", "", ""])[:3]
        if s == "connected" and t in ("wifi", "ethernet"):
            return {"online": True, "type": t, "name": c}
    return {"online": False}


def connect(ssid, pw):
    args = ["dev", "wifi", "connect", ssid]
    if pw:
        args += ["password", pw]
    r = nmcli(*args)
    return r.returncode == 0, (r.stdout + r.stderr).strip()


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def reply(self, code, body, ctype="application/json"):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def host_ok(self):
        return self.headers.get("Host") in HOSTS

    def do_GET(self):
        if not self.host_ok():
            return self.reply(403, "{}")
        if self.path == "/":
            self.reply(200, PAGE, "text/html")
        elif self.path == "/api/status":
            self.reply(200, json.dumps(status()))
        elif self.path == "/api/scan":
            self.reply(200, json.dumps(scan()))
        else:
            self.reply(404, "{}")

    def do_POST(self):
        # Websites you visit must not be able to change your Wi-Fi:
        # require our own origin and header.
        if not (self.host_ok() and self.path == "/api/connect"
                and self.headers.get("Origin") in ORIGINS
                and self.headers.get("X-BrowserOS") == "1"):
            return self.reply(403, "{}")
        try:
            n = int(self.headers.get("Content-Length", "0"))
            d = json.loads(self.rfile.read(min(n, 4096)))
            ssid, pw = str(d["ssid"]), str(d.get("password", ""))
        except Exception:
            return self.reply(400, "{}")
        if not ssid or ssid.startswith("-"):
            return self.reply(400, "{}")
        ok, msg = connect(ssid, pw)
        self.reply(200, json.dumps({"ok": ok, "message": msg}))


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
