[Unit]
Description=Browser OS (full-screen Chromium)
After=systemd-user-sessions.service live-config.service dbus.socket systemd-logind.service getty@tty1.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=user
PAMName=login
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
ExecStart=/usr/bin/cage -s -- /usr/local/bin/browseros-session
Restart=always
RestartSec=1
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=graphical.target
Alias=display-manager.service
